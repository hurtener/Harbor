// agent_test.go — worked example of testing a Harbor agent via the
// public `harbortest` package. RunOnce drives the agent under a
// deterministic identity quadruple; AssertSequence pins the observed
// event-type sequence; AssertNoLeaks catches cross-tenant / cross-
// session payload leaks.
{{- if or .BuiltIns .CustomTools}}
//
// Because harbor.yaml declares tools, this file also carries the
// register-and-dispatch gate (TestRegisterTools_DispatchesThroughCatalog
// below): it proves a declared tool is not just COMPILED into
// RegisterTools but actually registered AND invoked through the tool
// catalog. A tools-declaring agent that never dispatches a tool is a
// false green — Go does not flag an unused exported func — so the gate
// asserts an observable dispatch signal, not merely that RegisterTools
// exists.
{{- end}}
//
// See https://pkg.go.dev/github.com/hurtener/Harbor/harbortest for the
// full surface.
package {{.GoPackageName}}

import (
	"context"
{{- if or .BuiltIns .CustomTools}}
	"encoding/json"
{{- end}}
{{- if and .BuiltIns (not .CustomTools)}}
	"errors"
{{- end}}
{{- if or .BuiltIns .CustomTools}}
	"fmt"
{{- end}}
	"testing"

	"github.com/hurtener/Harbor/harbortest"
{{- if or .BuiltIns .CustomTools}}
	"github.com/hurtener/Harbor/sdk/tools"
{{- end}}
{{- if .CustomTools}}

	customtools "github.com/example/{{.Name}}/tools"
{{- end}}
)

// TestEchoAgent_RoundTrips exercises the scaffolded EchoAgent through
// harbortest.RunOnce. Replace the assertions with whatever your real
// agent emits.
func TestEchoAgent_RoundTrips(t *testing.T) {
	agent := &EchoAgent{}
	out, log, err := harbortest.RunOnce(context.Background(), agent, "hello")
	if err != nil {
		t.Fatalf("RunOnce: unexpected error: %v", err)
	}
	if out != "hello" {
		t.Errorf("RunOnce: output expected %q, got %v", "hello", out)
	}
	// AssertNoLeaks is the cross-session-isolation gate. Even with
	// the scaffolded EchoAgent emitting no events, this assertion
	// stays green — and surfaces a regression the moment your real
	// agent emits an event under a foreign triple.
	harbortest.AssertNoLeaks(t, log)
}
{{- if or .BuiltIns .CustomTools}}

// TestRegisterTools_DispatchesThroughCatalog is the register-and-dispatch
// gate for a tools-declaring agent. It registers every declared tool
// onto a real catalog via RegisterTools, then drives at least one tool
// THROUGH the catalog's executor under a Harbor identity (via RunOnce),
// asserting the tool's effect is observed. If RegisterTools wires
// nothing — the classic false green where a tools-declaring agent
// compiles and passes while no tool is ever invoked — the Resolve below
// fails loudly. Keep this test green as you replace the stubs with real
// tools; it is the proof your tool wiring actually dispatches.
func TestRegisterTools_DispatchesThroughCatalog(t *testing.T) {
	dispatched, log, err := harbortest.RunOnce(context.Background(),
		harbortest.AgentFunc(func(ctx context.Context, _ any) (any, error) {
			cat := tools.NewCatalog()
			if err := RegisterTools(cat); err != nil {
				return nil, fmt.Errorf("RegisterTools: %w", err)
			}
{{- if .CustomTools}}
{{- $tool := index .CustomTools 0}}
			// Dispatch the first declared custom tool through the catalog.
			desc, ok := cat.Resolve("{{$tool.Name}}")
			if !ok {
				return nil, fmt.Errorf("tool %q absent from catalog after RegisterTools — registration did not dispatch it", "{{$tool.Name}}")
			}
			args, err := json.Marshal(customtools.{{$tool.GoIdent}}Input{})
			if err != nil {
				return nil, fmt.Errorf("marshal args for %q: %w", "{{$tool.Name}}", err)
			}
			res, err := desc.Invoke(ctx, args)
			if err != nil {
				return nil, fmt.Errorf("dispatch %q through catalog: %w", "{{$tool.Name}}", err)
			}
			// res.Value is the tool's typed output — the observed effect
			// of a real catalog dispatch.
			return res.Value, nil
{{- else}}
{{- $name := index .BuiltIns 0}}
			// No custom tools declared — dispatch the first built-in.
			desc, ok := cat.Resolve("{{$name}}")
			if !ok {
				return nil, fmt.Errorf("built-in %q absent from catalog after RegisterTools — registration did not dispatch it", "{{$name}}")
			}
			// Reaching the executor IS the dispatch signal. A stub
			// built-in may reject the empty payload with an args
			// validation error; that still proves the register-and-
			// dispatch wiring fired. Only ErrToolNotFound — registration
			// produced nothing — is the false green this gate catches.
			if _, derr := desc.Invoke(ctx, json.RawMessage(`{}`)); errors.Is(derr, tools.ErrToolNotFound) {
				return nil, fmt.Errorf("built-in %q not dispatchable through catalog: %w", "{{$name}}", derr)
			}
			return "{{$name}}", nil
{{- end}}
		}), nil)
	if err != nil {
		t.Fatalf("register-and-dispatch gate failed: %v", err)
	}
	if dispatched == nil {
		t.Fatal("register-and-dispatch gate: tool produced no observable result; dispatch did not occur")
	}
	// Cross-session isolation gate — same contract as the echo test.
	harbortest.AssertNoLeaks(t, log)
}
{{- end}}
