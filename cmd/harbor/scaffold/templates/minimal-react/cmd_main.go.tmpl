// Command {{.Name}} serves the Harbor Protocol from this project's own
// binary, carrying the compiled in-process tools RegisterTools wires.
//
// It is the external-serving sibling of `harbor serve`: same production
// posture (a JWKS-backed JWT verifier built from identity.jwks_url /
// identity.jwks_file; no dev signer, no mock), reached through the
// public sdk/server facade.
//
// # Local-development loop (the harbor token three-command flow)
//
// This server verifies every request against your identity provider's
// JWK Set. For local development, mint your own keypair + token:
//
//	# 1. Generate a signing keypair + public JWK Set.
//	harbor token keygen --out ./keys
//
//	# 2. Point identity.jwks_file at the emitted set in harbor.yaml:
//	#      identity:
//	#        jwks_file: ./keys/jwks.json
//	#    (and remove identity.jwks_url — set exactly one source).
//
//	# 3. Build + run this server.
//	go build ./cmd/{{.Name}} && ./{{.Name}} --config ./harbor.yaml
//
//	# 4. Mint a short-lived JWT whose iss/aud match harbor.yaml, then
//	#    call the Protocol with it:
//	harbor token mint --key ./keys/private.pem \
//	    --tenant acme --user alice --session s1 \
//	    --issuer <identity.issuer> --audience <identity.audience>
//
// Before any non-local deployment, replace identity.issuer /
// identity.audience / the JWKS source with your real OIDC provider's
// values.
package main

import (
	"context"
	"flag"
	"fmt"
	"os"
	"os/signal"
	"syscall"
	{{if .WithTUI}}
	"bytes"
	"errors"
	"io"
	"path/filepath"
	"strings"
	"time"
	{{end}}
	// Blank-import the production driver aggregator so every store /
	// bus / LLM the runtime opens resolves its real driver.
	_ "github.com/hurtener/Harbor/sdk/drivers/prod"

	"github.com/hurtener/Harbor/sdk/config"
	"github.com/hurtener/Harbor/sdk/server"
	{{if .WithTUI}}
	protocolclient "github.com/hurtener/Harbor/sdk/protocolclient"
	tui "github.com/hurtener/Harbor/sdk/tui"
	{{end}}
	agent "github.com/example/{{.Name}}"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, "{{.Name}}:", err)
		os.Exit(1)
	}
}

// run loads the configuration, opens the Protocol server with this
// project's tools registered at the pre-policy catalog seam, and serves
// until SIGINT / SIGTERM.
func run() error {
	// The flag trio mirrors `harbor serve`: --config, --bind (overrides
	// server.bind_addr; the HARBOR_BIND env var is the flagless
	// equivalent), and --port (a backstop used only when the config
	// carries no server.bind_addr — config loading defaults it, so
	// --bind is the practical override).
	configPath := flag.String("config", "harbor.yaml", "path to harbor.yaml")
	port := flag.Int("port", 8686, "backstop port used only if the config carries no server.bind_addr (config loading defaults it, so --bind is the practical override)")
	bind := flag.String("bind", "", "host:port to bind (overrides server.bind_addr; host:0 = ephemeral)")
	{{if .WithTUI}}tuiFlag := flag.Bool("tui", false, "co-launch the native terminal client after readiness (attaches through authenticated REST/SSE; quit drains the server)")
	{{end}}flag.Parse()

	ctx, stop := signal.NotifyContext(context.Background(), syscall.SIGINT, syscall.SIGTERM)
	defer stop()

	cfg, err := config.Load(ctx, *configPath)
	if err != nil {
		return fmt.Errorf("load config: %w", err)
	}

	// --bind (or HARBOR_BIND) overrides the configured bind address; the
	// --port fallback applies only when neither is set and the config
	// carries no bind_addr.
	bindOverride := *bind
	if bindOverride == "" {
		bindOverride = os.Getenv("HARBOR_BIND")
	}
	switch {
	case bindOverride != "":
		cfg.Server.BindAddr = bindOverride
	case cfg.Server.BindAddr == "":
		cfg.Server.BindAddr = fmt.Sprintf("127.0.0.1:%d", *port)
	}

	{{if .WithTUI}}// Co-launch log separation: when --tui is set, Runtime stderr
	// (HARBOR_DEV_BOUND, slog output, lifecycle banners) goes to a
	// captured buffer, not the terminal. Bubble Tea owns stdout+stderr.
	// The sink is forwarded into the serve band through
	// server.Options.Stderr so every Runtime log line lands in the
	// buffer. On failure the terminal is restored before the captured
	// log is printed.
	var logSink io.Writer = os.Stderr
	var capturedLog *bytes.Buffer
	if *tuiFlag {
		capturedLog = &bytes.Buffer{}
		logSink = capturedLog
	}
	{{end}}
	h, err := server.Open(ctx, cfg, server.Options{
		// This scaffold cannot know the immutable Harbor source commit your
		// release uses. Set Framework to its exact version+commit in release
		// build configuration; leave it zero for local development. runtime.info
		// then exposes additive framework_* provenance without changing build_*.
		// RegisterTools registers this project's compiled tools at the
		// pre-policy catalog seam, so each keeps its declared approval /
		// OAuth / policy wrapping from tools.entries in harbor.yaml.
		RegisterCatalog: agent.RegisterTools,
		{{if .WithTUI}}Stderr: logSink,
		{{end}}
	})
	if err != nil {
		{{if .WithTUI}}if *tuiFlag && capturedLog != nil {
			fmt.Fprintln(os.Stderr, "--- Runtime log (captured during co-launch) ---")
			os.Stderr.Write(capturedLog.Bytes())
		}
		{{end}}return fmt.Errorf("open server: %w", err)
	}
	defer func() { _ = h.Close(context.Background()) }()

	{{if .WithTUI}}if !*tuiFlag {
		// Headless path: the original behavior, unchanged.
		if err := h.Serve(ctx); err != nil {
			return fmt.Errorf("serve: %w", err)
		}
		return nil
	}

	// Co-launch path (--tui): serve in a goroutine, wait for readiness,
	// attach the TUI, and on TUI exit drain the owned server.
	serveErrCh := make(chan error, 1)
	go func() { serveErrCh <- h.Serve(ctx) }()

	readyCtx, readyCancel := context.WithTimeout(ctx, 30*time.Second)
	boundAddr, err := h.WaitReady(readyCtx)
	readyCancel()
	if err != nil {
		stop()
		<-serveErrCh
		fmt.Fprintln(os.Stderr, "--- Runtime log (captured during co-launch) ---")
		if capturedLog != nil {
			os.Stderr.Write(capturedLog.Bytes())
		}
		return fmt.Errorf("server readiness failed: %w", err)
	}

	// Resolve the operator token. No anonymous loopback, no automatic
	// minting, no mock fallback.
	token := os.Getenv("HARBOR_TOKEN")
	if token == "" {
		home, _ := os.UserHomeDir()
		body, rErr := os.ReadFile(filepath.Join(home, ".harbor", "token"))
		if rErr != nil {
			stop()
			<-serveErrCh
			return fmt.Errorf("resolve token: set HARBOR_TOKEN or write ~/.harbor/token: %w", rErr)
		}
		token = strings.TrimSpace(string(body))
	}
	tokens := protocolclient.TokenSourceFunc(func(_ context.Context, _ protocolclient.IdentityScope) (string, error) {
		return token, nil
	})
	baseURL := "http://" + boundAddr
	tuiErr := tui.Run(ctx, tui.Options{BaseURL: baseURL, Token: tokens})

	// Drain the owned server (co-launch quit drains its server).
	stop()
	serveErr := <-serveErrCh
	if capturedLog != nil && capturedLog.Len() > 0 {
		fmt.Fprintln(os.Stderr, "--- Runtime log (captured during co-launch) ---")
		os.Stderr.Write(capturedLog.Bytes())
	}
	if tuiErr != nil {
		return fmt.Errorf("tui: %w", tuiErr)
	}
	if serveErr != nil && !errors.Is(serveErr, context.Canceled) {
		return fmt.Errorf("co-launched server stopped: %w", serveErr)
	}
	return nil
	{{else}}// Serve blocks until ctx cancels (SIGINT / SIGTERM), then drains.
	if err := h.Serve(ctx); err != nil {
		return fmt.Errorf("serve: %w", err)
	}
	return nil
	{{end}}
}
